+
+static void ik_emit_runtime_event(
+        const char * event,
+        int task_id,
+        int slot_id,
+        int n_tokens,
+        llama_pos kv_pos_min,
+        llama_pos kv_pos_max,
+        size_t kv_state_bytes) {
+    const char * path = std::getenv("IK_EVENT_LOG");
+    if (path == nullptr || path[0] == 0) {
+        return;
+    }
+
+    static std::mutex mutex;
+    const auto wall_us = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+
+    std::lock_guard<std::mutex> lock(mutex);
+    std::ofstream out(path, std::ios::app);
+    if (!out) {
+        return;
+    }
+    out << "{\"schema\":\"ik.runtime.v1\","
+        << "\"event\":\"" << event << "\","
+        << "\"t_guest_mono_us\":" << ggml_time_us() << ","
+        << "\"t_wall_unix_us\":" << wall_us << ","
+        << "\"pid\":" << ik_process_id() << ","
+        << "\"tid\":" << ik_thread_id() << ","
+        << "\"task_id\":" << task_id << ","
+        << "\"slot_id\":" << slot_id << ","
+        << "\"n_tokens\":" << n_tokens << ","
+        << "\"kv_pos_min\":" << kv_pos_min << ","
+        << "\"kv_pos_max\":" << kv_pos_max << ","
+        << "\"kv_state_bytes\":" << kv_state_bytes << "}\n";
+}
