+struct ik_tensor_capture_state {
+    std::atomic<bool> active{false};
+    std::atomic<int> task_id{-1};
+    std::atomic<int> slot_id{-1};
+    std::atomic<int> batch_tokens{0};
+    std::atomic<int> output_row{-1};
+    std::atomic<int64_t> forward_pass_id{0};
+    std::atomic<int64_t> evaluated_position{-1};
+    std::atomic<int64_t> next_forward_pass_id{0};
+    std::string directory;
+    std::string arm_path;
+    std::vector<uint32_t> layers;
+    std::mutex write_mutex;
+};
+
+static bool ik_tensor_capture_name_allowed(
+        const std::string & name,
+        const std::vector<uint32_t> & layers) {
+    static const std::vector<std::string> stages = {
+        "layer_inp", "attn_norm", "Qcur", "Kcur", "Vcur",
+        "kq_soft_max", "kqv", "kqv_out", "ffn_inp", "ffn_norm",
+        "ffn_out", "l_out"
+    };
+    for (const auto & stage : stages) {
+        const std::string prefix = stage + "-";
+        if (name.rfind(prefix, 0) != 0) {
+            continue;
+        }
+        char * tail = nullptr;
+        const long layer = std::strtol(name.c_str() + prefix.size(), &tail, 10);
+        if (tail == name.c_str() + prefix.size() || *tail != 0 || layer < 0) {
+            return false;
+        }
+        return std::find(layers.begin(), layers.end(), static_cast<uint32_t>(layer)) != layers.end();
+    }
+    return name == "result_norm" || name == "result_output";
+}
+
+static bool ik_tensor_capture_cb(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto * state = static_cast<ik_tensor_capture_state *>(user_data);
+    if (state == nullptr || !state->active.load(std::memory_order_acquire) || tensor == nullptr) {
+        return false;
+    }
+    const std::string name(tensor->name);
+    if (!ik_tensor_capture_name_allowed(name, state->layers)) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+
+    const size_t n_bytes = ggml_nbytes(tensor);
+    std::vector<uint8_t> bytes(n_bytes);
+    if (ggml_backend_buffer_is_host(tensor->buffer)) {
+        if (tensor->data == nullptr) {
+            return false;
+        }
+        std::memcpy(bytes.data(), tensor->data, n_bytes);
+    } else {
+        ggml_backend_tensor_get(tensor, bytes.data(), 0, n_bytes);
+    }
+
+    const int64_t pass_id = state->forward_pass_id.load(std::memory_order_relaxed);
+    const int task_id = state->task_id.load(std::memory_order_relaxed);
+    const int slot_id = state->slot_id.load(std::memory_order_relaxed);
+    const auto wall_us = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+    const std::string stem = "pass-" + std::to_string(pass_id)
+            + "-task-" + std::to_string(task_id)
+            + "-slot-" + std::to_string(slot_id)
+            + "-" + name;
+    const std::filesystem::path directory(state->directory);
+    const std::filesystem::path binary_path = directory / (stem + ".bin");
+    const std::filesystem::path manifest_path = directory / "manifest.jsonl";
+
+    std::lock_guard<std::mutex> lock(state->write_mutex);
+    std::filesystem::create_directories(directory);
+    {
+        std::ofstream binary(binary_path, std::ios::binary | std::ios::trunc);
+        if (!binary) {
+            return false;
+        }
+        binary.write(reinterpret_cast<const char *>(bytes.data()), bytes.size());
+        if (!binary) {
+            return false;
+        }
+    }
+    std::ofstream manifest(manifest_path, std::ios::app);
+    if (!manifest) {
+        return false;
+    }
+    manifest << "{\"schema\":\"ik.transformer-tensor.v1\","
+             << "\"event\":\"tensor_capture\","
+             << "\"t_guest_mono_us\":" << ggml_time_us() << ","
+             << "\"t_wall_unix_us\":" << wall_us << ","
+             << "\"pid\":" << ik_process_id() << ","
+             << "\"tid\":" << ik_thread_id() << ","
+             << "\"task_id\":" << task_id << ","
+             << "\"slot_id\":" << slot_id << ","
+             << "\"forward_pass_id\":" << pass_id << ","
+             << "\"evaluated_position\":" << state->evaluated_position.load() << ","
+             << "\"batch_tokens\":" << state->batch_tokens.load() << ","
+             << "\"output_row\":" << state->output_row.load() << ","
+             << "\"tensor_name\":\"" << name << "\","
+             << "\"tensor_type\":\"" << ggml_type_name(tensor->type) << "\","
+             << "\"shape\":[" << tensor->ne[0] << ',' << tensor->ne[1] << ','
+             << tensor->ne[2] << ',' << tensor->ne[3] << "],"
+             << "\"strides\":[" << tensor->nb[0] << ',' << tensor->nb[1] << ','
+             << tensor->nb[2] << ',' << tensor->nb[3] << "],"
+             << "\"byte_count\":" << n_bytes << ","
+             << "\"binary_file\":\"" << binary_path.filename().string() << "\"}\n";
+    return true;
+}
